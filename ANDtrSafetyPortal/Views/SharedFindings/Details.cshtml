@model ANDtrSafetyPortal.Models.RiskReview

@{
    ViewData["Title"] = "Risk Review Details";
}

<div class="container mt-4">

    <h2>Risk Review Details</h2>

    <p class="text-muted">
        View the medical device risk review shared with you.
    </p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">

            <h4>@Model.Title</h4>

            <hr />

            <p>
                <strong>Review ID:</strong>
                @Model.ReviewID
            </p>

            <p>
                <strong>Employee ID:</strong>
                @Model.EmployeeID
            </p>

            <p>
                <strong>Status:</strong>
                @Model.Status
            </p>

        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h4>Linked Safety Notices</h4>
            <hr />

            
            @if (ViewBag.LinkedNotices != null &&
                 ((List<string>)ViewBag.LinkedNotices).Any())
            {
                <ul class="list-group">
                    @foreach (string recall in ViewBag.LinkedNotices)
                    {
                        <li class="list-group-item">
                            <strong>Recall Number:</strong> @recall
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">
                    No safety notices linked to this review.
                </p>
            }

        </div>
    </div>

    <a asp-controller="SharedFindings"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Shared Findings
    </a>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h4>Customer Comments</h4>
            <hr />

            @if (ViewBag.ReviewComments != null &&
                 ((List<ANDtrSafetyPortal.Models.Comment>)ViewBag.ReviewComments).Any())
            {
                @foreach (var comment in ViewBag.ReviewComments)
                {
                    <div class="alert alert-light border">
                        <strong>User @comment.UserID:</strong>
                        @comment.CommentText
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No comments yet.</p>
            }
        </div>
    </div>


</div>
